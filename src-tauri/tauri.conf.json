{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Archaeologist",
  "version": "0.11.0",
  "identifier": "dev.higorhlg.devarchaeologist",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "title": "Dev Archaeologist", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 520 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
